        {"id": "core-tu", "type": "word", "text": "tu", "audioText": "tu", "ipa": "/ty/", "translation": "你", "examples": [{"text": "Tu comprends ?", "audioText": "Tu comprends ?", "ipa": "/ty kɔ̃pʁɑ̃/", "translation": "你懂吗？"}]},
